# Deployment configuration for scripts/deploy.sh (used by `make deploy`).
#
# Copy this file to `deploy.env` and fill in the real values.
# `deploy.env` is gitignored and MUST stay out of the repository:
# the repo is public, so server names, addresses, and secrets never go here.

# SSH destination for the server (an alias from ~/.ssh/config or user@host).
DEPLOY_SSH_HOST=my-server

# Name of the LXD container on the server that runs the app.
DEPLOY_LXD_CONTAINER=my-container

# Application directory inside the container.
DEPLOY_APP_DIR=/opt/ai-proxy2

# Space-separated Docker Compose files to use inside the container.
# Server-specific overrides live only on the server and are never deleted
# by the deploy (e.g. "docker-compose.yml docker-compose.myhost.yml").
DEPLOY_COMPOSE_FILES="docker-compose.yml"

# Staging directory on the server host (outside the container).
DEPLOY_STAGING_DIR=.deploy-staging/ai-proxy2

# Optional: URL checked from the local machine after the deploy.
# Leave empty to skip the health check.
DEPLOY_HEALTH_URL=
